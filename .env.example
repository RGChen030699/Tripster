# Copy this file to .env and replace USERNAME with your local PostgreSQL role.
# Homebrew PostgreSQL with trust authentication does not need a password.
# Point tests at the isolated database with DATABASE_URL_TEST. Do not use the development database for tests.
# Do not commit a real database URL, password, or other secret.
DATABASE_URL="postgresql://USERNAME@localhost:5432/tripster"
DATABASE_URL_TEST="postgresql://USERNAME@localhost:5432/tripster_test"
